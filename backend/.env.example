# ─── Database ───────────────────────────────────────────────
# PostgreSQL (primary)
DATABASE_URL=postgresql+asyncpg://cat:cat_secret@localhost:5432/machops360
# SQLite fallback for demo (set USE_SQLITE=true)
USE_SQLITE=false
SQLITE_URL=sqlite+aiosqlite:///./machops360_demo.db

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── App ────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
FRONTEND_ORIGIN=http://localhost:5173

# ─── ML ─────────────────────────────────────────────────────
ML_MODELS_DIR=../ml/models
ETA_MODEL_PATH=../ml/models/eta_model.joblib
ANOMALY_MODEL_PATH=../ml/models/anomaly_model.joblib

# ─── RAG / LLM ──────────────────────────────────────────────
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_URL=http://localhost:11434

# ─── Safety Thresholds ──────────────────────────────────────
PROXIMITY_WARNING_METERS=10.0
PROXIMITY_CRITICAL_METERS=5.0
SPEED_LIMIT_DEFAULT_KMH=20.0
MAX_LOAD_WARNING_PCT=90.0
MAX_LOAD_CRITICAL_PCT=100.0
ENGINE_TEMP_WARNING_C=105.0
ENGINE_TEMP_CRITICAL_C=115.0
MAX_IDLE_MINUTES=15.0
MAX_CONTINUOUS_OPERATING_MINUTES=90.0
FATIGUE_RISK_THRESHOLD=0.75

# ─── Demo ───────────────────────────────────────────────────
DEMO_SEED=42
AUTO_SEED_ON_STARTUP=true
